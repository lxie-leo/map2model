# map2model backend configuration (copy to .env and adjust)
# All vars are prefixed with M2M_. List values are JSON arrays.

# Overpass endpoints, order = priority (China-friendly first)
M2M_OVERPASS_ENDPOINTS=["https://overpass.kumi.systems/api/interpreter","https://maps.mail.ru/osm/tools/overpass/api/interpreter","https://overpass-api.de/api/interpreter","https://overpass.osm.jp/api/interpreter"]
M2M_OVERPASS_TIMEOUT=120

# AWS Terrain Tiles (terrarium) PNG template
M2M_TERRAIN_URL_TEMPLATE=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
M2M_TERRAIN_Z_MAX=13
M2M_TERRAIN_MAX_TILES=64

# Guards
M2M_MAX_BBOX_AREA_KM2=25
M2M_MAX_BUILDINGS=20000
M2M_GRID_MAX_VERTS=512

# Concurrency
M2M_TASK_CONCURRENCY=2

# Blender executable for FBX/DAE export: "auto" | path | "off"
M2M_BLENDER_PATH=auto

# Data directory (cache + tasks + sqlite), relative to backend/ by default
M2M_DATA_DIR=data

# CORS
M2M_CORS_ORIGINS=["*"]
